---
layout: base.njk
pagination:
  data: book.parts
  size: 1
  alias: part
permalink: "/part/{{ part.part }}/"
eleventyComputed:
  title: "Part {{ part.part }}"
---
{% set current = part.part %}
{% include "trail.njk" %}

<article class="part">
  <header class="part-header">
    <p class="eyebrow">Part {{ part.part }} of {{ book.parts | length }} · {{ part.chapterRange }}</p>
    <h1>Part {{ part.part }}</h1>
    <p class="lede">{{ part.chapterNames | join(" · ") }}</p>
  </header>

  {%- if part.images[0] %}
  {% set img = part.images[0] %}{% set eager = true %}
  {% include "picture.njk" %}
  {%- else %}
  <figure class="picture picture--placeholder">
    {% include "svg/island-scene.svg" %}
  </figure>
  {%- endif %}

  <section class="section" aria-labelledby="words-heading">
    <h2 id="words-heading">Words to know</h2>
    {% set words = part.glossary %}
    {% include "words.njk" %}
  </section>

  {%- if part.images[1] %}
  {% set img = part.images[1] %}{% set eager = false %}
  {% include "picture.njk" %}
  {%- else %}
  {% include "divider.njk" %}
  {%- endif %}

  <section class="section" aria-labelledby="questions-heading">
    <h2 id="questions-heading">Let’s think</h2>
    <ol class="question-cards">
      {%- for q in part.questions %}
      <li>{{ q }}</li>
      {%- endfor %}
      {%- if part.thinkingQuestion %}
      <li class="question--think"><span class="question-label">Think about it</span>{{ part.thinkingQuestion }}</li>
      {%- endif %}
      {%- if part.extraQuestion %}
      <li class="question--extra"><span class="question-label">Extra</span>{{ part.extraQuestion }}</li>
      {%- endif %}
    </ol>
  </section>

  {%- if part.images[2] %}
  {% set img = part.images[2] %}{% set eager = false %}
  {% include "picture.njk" %}
  {%- endif %}

  <div class="read-toggle">
    <button type="button" class="button" data-read-toggle="{{ part.part }}" aria-pressed="false" hidden>
      <span class="read-toggle-off">I’ve read Part {{ part.part }}</span>
      <span class="read-toggle-on">✓ Part {{ part.part }} read</span>
    </button>
  </div>
</article>

<nav class="pager" aria-label="Parts">
  {%- if pagination.href.previous %}
  <a class="button" rel="prev" href="{{ pagination.href.previous }}">← Part {{ part.part - 1 }}</a>
  {%- else %}
  <a class="button" href="/">← All parts</a>
  {%- endif %}
  {%- if pagination.href.next %}
  <a class="button button--primary" rel="next" href="{{ pagination.href.next }}">Part {{ part.part + 1 }} →</a>
  {%- else %}
  <a class="button button--primary" href="/">The end · All parts</a>
  {%- endif %}
</nav>
