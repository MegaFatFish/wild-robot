<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <title>{% if title %}{{ title }} · {% endif %}The Wild Robot</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&family=Fraunces:opsz,wght,SOFT@9..144,400..700,0..100&display=swap">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="site-header">
    <a class="home" href="/">
      {% include "svg/island-mark.svg" %}
      <span>The Wild Robot</span>
    </a>
  </header>

  <main class="page">
    {{ content | safe }}
  </main>

  <script>
    // Word meanings are collapsed on screen; open them all when printing.
    addEventListener("beforeprint", () => {
      document.querySelectorAll("details").forEach((d) => (d.open = true));
    });

    // "I've read this part" is remembered in this browser only.
    // Storage can be blocked (private windows), so the page works without it.
    (() => {
      const KEY = "wild-robot:read";
      const load = () => {
        try { return new Set(JSON.parse(localStorage.getItem(KEY)) ?? []); } catch { return new Set(); }
      };
      const save = (read) => {
        try { localStorage.setItem(KEY, JSON.stringify([...read])); return true; } catch { return false; }
      };

      function paint(read) {
        document.querySelectorAll("[data-part]").forEach((el) => {
          const isRead = read.has(Number(el.dataset.part));
          el.classList.toggle("is-read", isRead);
          if (el.classList.contains("stone")) {
            el.title = `Part ${el.dataset.part}${isRead ? " · read" : ""}`;
            el.querySelector(".visually-hidden").textContent = el.title;
          }
        });
        document.querySelectorAll("[data-read-toggle]").forEach((btn) => {
          btn.setAttribute("aria-pressed", read.has(Number(btn.dataset.readToggle)));
        });
      }

      const read = load();
      paint(read);

      document.querySelectorAll("[data-read-toggle]").forEach((btn) => {
        const part = Number(btn.dataset.readToggle);
        btn.hidden = !save(read); // no storage, no button
        btn.addEventListener("click", () => {
          read.has(part) ? read.delete(part) : read.add(part);
          save(read);
          paint(read);
        });
      });
    })();
  </script>
</body>
</html>
